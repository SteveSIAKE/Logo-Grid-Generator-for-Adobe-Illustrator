<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="12.0" ExtensionBundleId="com.logogridgenerator.illustrator" ExtensionBundleVersion="0.4.0" ExtensionBundleName="Logo Grid Generator">
  <ExtensionList>
    <Extension Id="com.logogridgenerator.illustrator.panel" Version="0.4.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- Illustrator 2024+ (v28). Upper bound keeps panel loading on future versions. -->
      <Host Name="ILST" Version="[28.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <!-- CEP 12 = Illustrator 2026 (moteur CEPHtmlEngine 12.x). Pour Illustrator 2024 (CEP 11), redescendre a 11.0. -->
      <RequiredRuntime Name="CSXS" Version="12.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.logogridgenerator.illustrator.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
        </Resources>
        <UI>
          <Type>Panel</Type>
          <Menu>Logo Grid Generator</Menu>
          <Geometry>
            <Size>
              <Height>720</Height>
              <Width>320</Width>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
